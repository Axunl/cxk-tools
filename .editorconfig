is_root = true

# 全局默认：UTF-8（无 BOM）+ LF + 4 空格缩进
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# cmd.exe 按本地代码页解析批处理，存 UTF-8 会吞换行导致脚本崩掉
# （本项目已踩过两次），因此 .bat/.cmd 强制 latin1 + CRLF，且内容必须纯 ASCII。
[*.{bat,cmd}]
charset = latin1
end_of_line = crlf
indent_size = 2

[*.{qss,qrc,cmake,txt}]
indent_size = 4

[*.md]
# Markdown 的行尾双空格是硬换行，不能裁掉
trim_trailing_whitespace = false

[*.sh]
indent_size = 4


