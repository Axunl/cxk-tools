/* ===========================================================================
   全局样式表（浅色主题）
   ---------------------------------------------------------------------------
   规则：
     * 只通过 objectName / 属性选择器定位控件，代码里不写内联样式，
       主题调整集中在这一个文件；
     * 强调按钮统一用属性 accent=true（见下方 QPushButton[accent="true"]），
       不要在业务代码里 setStyleSheet 调色；
     * 尺寸按逻辑像素写，Qt 会按屏幕 DPR 自动缩放。
   =========================================================================== */

QWidget {
    font-family: "Microsoft YaHei UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 13px;
    color: #0F172A;
}

/* ---------------------------------------------------------------- 根容器 */
#mainRoot {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

/* ---------------------------------------------------------------- 标题栏 */
#titleBar {
    background: #FFFFFF;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 1px solid #E8EDF5;
}

#titleText {
    font-size: 13px;
    font-weight: 600;
    color: #0F172A;
}

#titleHotkey {
    font-size: 11px;
    color: #94A3B8;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 9px;
    padding: 1px 8px;
}

QPushButton#titleBtn,
QPushButton#titleBtnClose {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #475569;
    font-size: 16px;
    /* 必须清零：全局 QPushButton 有 padding: 6px 14px，
       在 30px 宽的按钮里会把文字挤到没有空间，只剩一个小点。 */
    padding: 0px;
    min-height: 0px;
}

QPushButton#titleBtn:hover {
    background: #F1F5F9;
    color: #0F172A;
}

QPushButton#titleBtnClose:hover {
    background: #EF4444;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------- 侧边栏 */
#sidebar {
    background: #F1F5F9;
    border-right: 1px solid #E2E8F0;
    border-bottom-left-radius: 10px;
}

QLineEdit#sideSearch {
    margin: 0 10px;
    padding: 6px 10px;
    min-height: 22px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 7px;
    color: #0F172A;
}

QLineEdit#sideSearch:focus {
    border-color: #4F6BF6;
    background: #FFFFFF;
}

QListWidget#sideList {
    background: transparent;
    border: none;
    padding: 0 6px;
    outline: none;
}

QListWidget#sideList::item {
    height: 32px;
    border-radius: 7px;
    padding-left: 8px;
    /* 注意：::item 的左右 padding 与 iconSize 配合决定图标与文字间距 */
}

QListWidget#sideList::item:selected {
    background: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
}

QListWidget#sideList::item:hover:!selected {
    background: #E9EFF8;
}

#sideFooter {
    color: #94A3B8;
    font-size: 11px;
    padding: 2px 10px;
}

/* ---------------------------------------------------------------- 右侧内容 */
#pageHeader {
    background: #F8FAFC;
}

#toolTitle {
    font-size: 16px;
    font-weight: 600;
    color: #0F172A;
}

#toolDesc {
    font-size: 12px;
    color: #94A3B8;
}

#toolStack {
    background: #F8FAFC;
    border-bottom-right-radius: 10px;
}

/* ---------------------------------------------------------------- 分组框 */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 0px;
    padding: 0 4px;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    background: #F8FAFC;
}

/* ---------------------------------------------------------------- 按钮 */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D7DEE9;
    border-radius: 7px;
    padding: 6px 14px;
    min-height: 20px;
    color: #334155;
}

QPushButton:hover {
    background: #F5F8FD;
    border-color: #C3CEDD;
}

QPushButton:pressed {
    background: #EBF1F9;
}

QPushButton[accent="true"] {
    background: #4F6BF6;
    border: 1px solid #4F6BF6;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[accent="true"]:hover {
    background: #4360EE;
    border-color: #4360EE;
}

/* ---------------------------------------------------------------- 输入类 */
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D7DEE9;
    border-radius: 7px;
    padding: 6px 10px;
    selection-background-color: #4F6BF6;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border-color: #4F6BF6;
}

QPlainTextEdit,
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #4F6BF6;
    selection-color: #FFFFFF;
}

QCheckBox {
    color: #334155;
    spacing: 8px;
}

/* ---------------------------------------------------------------- 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #A9B7C9;
}

/* 上下箭头和空白页不要画出来（默认会留出方块的占位） */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------------------------------------------------------------- 其他 */
QSplitter::handle {
    background: #E8EDF5;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QToolTip {
    background: #0F172A;
    color: #F8FAFC;
    border: none;
    padding: 4px 8px;
}
