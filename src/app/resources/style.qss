/* ===========================================================================
   全局样式表（浅色主题）
   ---------------------------------------------------------------------------
   规则：
     * 只通过 objectName / 属性选择器定位控件，代码里不写内联样式，
       主题调整集中在这一个文件；
     * 强调按钮统一用属性 accent=true（见下方 QPushButton[accent="true"]），
       不要在业务代码里 setStyleSheet 调色；
     * 尺寸按逻辑像素写，Qt 会按屏幕 DPR 自动缩放。
   =========================================================================== */

QWidget {
    font-family: "Microsoft YaHei UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 13px;
    color: #0F172A;
}

/* ---------------------------------------------------------------- 根容器 */
#mainRoot {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

/* ---------------------------------------------------------------- 标题栏 */
#titleBar {
    background: #FFFFFF;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 1px solid #E8EDF5;
}

#titleText {
    font-size: 13px;
    font-weight: 600;
    color: #0F172A;
}

#titleHotkey {
    font-size: 11px;
    color: #94A3B8;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 9px;
    padding: 1px 8px;
}

QPushButton#titleBtn,
QPushButton#titleBtnSettings,
QPushButton#titleBtnClose {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #475569;
    font-size: 16px;
    /* 必须清零：全局 QPushButton 有 padding: 6px 14px，
       在 30px 宽的按钮里会把文字挤到没有空间，只剩一个小点。 */
    padding: 0px;
    min-height: 0px;
}

QPushButton#titleBtn:hover,
QPushButton#titleBtnSettings:hover {
    background: #F1F5F9;
    color: #0F172A;
}

QPushButton#titleBtnClose:hover {
    background: #EF4444;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------- 首页网格 */
#homeRoot {
    background: #F8FAFC;
}

#homeTop {
    background: #F8FAFC;
}

QLineEdit#homeSearch {
    /* 右侧 padding 给清空按钮让位，文字不会滑到按钮底下 */
    padding: 8px 36px 8px 12px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 9px;
    color: #0F172A;
    font-size: 14px;
}

QLineEdit#homeSearch:focus {
    border-color: #4F6BF6;
    background: #FFFFFF;
}

/* 搜索框右内侧的清空按钮：几何由 HomePage 按尺寸实时摆位 */
QToolButton#homeSearchClear {
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #94A3B8;
    font-size: 11px;
}

QToolButton#homeSearchClear:hover {
    background: #E2E8F0;
    color: #475569;
}

QToolButton#homeSearchClear:pressed {
    background: #CBD5E1;
}

#homeScroll,
#homeContent {
    background: transparent;
    border: none;
}

#sectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: #94A3B8;
    padding: 8px 0 4px 2px;
}

/* 磁贴：默认透明，hover / 键盘选中才出底色。
   hover 用动态属性而不是 :hover —— QWidget 子类的 :hover 依赖样式引擎
   主动打 WA_Hover，跨 Qt 版本/平台不保证触发（LauncherTile 里显式设属性）。 */
#launcherTile {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
}

#launcherTile[hovered="true"] {
    background: #EEF2FF;
}

#launcherTile[current="true"] {
    background: #E6EBFF;
    border-color: #C7D2FE;
}

#tileName {
    font-size: 12px;
    color: #334155;
}

#homeFooter {
    color: #94A3B8;
    font-size: 11px;
    padding: 4px 28px 10px 28px;
}

#homeHint {
    color: #94A3B8;
    font-size: 12px;
    padding: 24px 0;
}

#homeEmptyTitle {
    font-size: 15px;
    font-weight: 600;
    color: #0F172A;
}

#homeEmptyDesc {
    font-size: 12px;
    color: #94A3B8;
}

/* ---------------------------------------------------------------- 页头 */
#pageHeader {
    background: #F8FAFC;
    border-bottom: 1px solid #E8EDF5;
}

QPushButton#pageBack {
    background: transparent;
    border: none;
    color: #475569;
    font-size: 12px;
    padding: 4px 8px;
}

QPushButton#pageBack:hover {
    background: #F1F5F9;
    color: #0F172A;
    border-radius: 6px;
}

QPushButton#pagePopout {
    background: #FFFFFF;
    border: 1px solid #D7DEE9;
    font-size: 12px;
    padding: 4px 10px;
}

#toolTitle {
    font-size: 16px;
    font-weight: 600;
    color: #0F172A;
}

#toolDesc {
    font-size: 12px;
    color: #94A3B8;
}

#toolStack {
    background: #F8FAFC;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* 独立窗口：外面是系统边框，内容区只负责底色，不要再套圆角 */
#toolWindowRoot {
    background: #F8FAFC;
}

/* ---------------------------------------------------------------- 分组框 */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 0px;
    padding: 0 4px;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    background: #F8FAFC;
}

/* ---------------------------------------------------------------- 按钮 */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D7DEE9;
    border-radius: 7px;
    padding: 6px 14px;
    min-height: 20px;
    color: #334155;
}

QPushButton:hover {
    background: #F5F8FD;
    border-color: #C3CEDD;
}

QPushButton:pressed {
    background: #EBF1F9;
}

QPushButton[accent="true"] {
    background: #4F6BF6;
    border: 1px solid #4F6BF6;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[accent="true"]:hover {
    background: #4360EE;
    border-color: #4360EE;
}

/* ---------------------------------------------------------------- 输入类 */
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D7DEE9;
    border-radius: 7px;
    padding: 6px 10px;
    selection-background-color: #4F6BF6;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border-color: #4F6BF6;
}

QPlainTextEdit,
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #4F6BF6;
    selection-color: #FFFFFF;
}

/* JSON 编辑器的键名补全弹窗。
   popup 是 QCompleter 内部创建的顶层 QAbstractItemView，只能靠 objectName 命中
   （见 plugins/jsonfmt/JsonEditor.cpp），不设样式就是系统默认外观，与卡片界面不搭。
   注意不要给 view 加 padding：item view 的 padding 会把 viewport 撑得比内容还小，
   明明只三五条候选也会常驻一根竖向滚动条（试过）。留白交给 item 的 padding。 */
QAbstractItemView#jsonCompleterPopup {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    outline: none;
    selection-background-color: #EEF2FF;
    selection-color: #0F172A;
}

QAbstractItemView#jsonCompleterPopup::item {
    min-height: 26px;
    padding: 0 10px;
    color: #0F172A;
}

QAbstractItemView#jsonCompleterPopup::item:selected {
    background: #EEF2FF;
    color: #1D4ED8;
}

QCheckBox {
    color: #334155;
    spacing: 8px;
}

/* ---------------------------------------------------------------- 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #A9B7C9;
}

/* 上下箭头和空白页不要画出来（默认会留出方块的占位） */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------------------------------------------------------------- 其他 */
QSplitter::handle {
    background: #E8EDF5;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QToolTip {
    background: #0F172A;
    color: #F8FAFC;
    border: none;
    padding: 4px 8px;
}
